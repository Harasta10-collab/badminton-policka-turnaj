rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{tournamentId} {
      // Diváci mohou výsledky pouze číst.
      allow read: if true;
      // Zapisovat smí pouze přihlášený účet pořadatele.
      allow write: if request.auth != null
        && request.auth.token.email == 'Harasta10@seznam.cz';
    }
  }
}
